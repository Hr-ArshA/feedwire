{
  "name": "feedwire",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Multi-user RSS reader on Nuxt, PostgreSQL and Redis",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "fetch-model": "node scripts/fetch-model.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "db:backup": "powershell -File scripts/backup.ps1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@lucide/vue": "^1.75.0",
    "@mozilla/readability": "^0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.12.1",
    "linkedom": "^0.18.15",
    "nuxt": "^4.6.4",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "reka-ui": "^2.11.0",
    "sanitize-html": "^2.18.2",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vitest": "^2.1.9"
  }
}
