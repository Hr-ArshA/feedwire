DATABASE_URL=postgres://feedwire:feedwire@localhost:5433/feedwire
REDIS_URL=redis://localhost:6380
SESSION_SECRET=change-me-in-production-please-32-bytes-min
PUBLIC_FEED_URL=https://news.ycombinator.com/rss
PUBLIC_SITE_URL=http://localhost:3000
# Optional: only needed if Hugging Face rate-limits the model download.
HF_TOKEN=
# Comma-separated accounts that get the /admin dashboard.
# If empty, the oldest account is promoted once so a fresh install has an operator.
ADMIN_EMAILS=
# Set to false to stop the background feed scheduler.
SCHEDULER_ENABLED=true
# Password reset delivery. Without a mail provider the link is written to the
# server log; set RESET_WEBHOOK_URL to POST { to, subject, resetUrl } to any
# transactional email service. RESET_LINK_IN_RESPONSE is on by default outside
# production so the reset link can be shown in the UI while developing.
RESET_WEBHOOK_URL=
RESET_LINK_IN_RESPONSE=false
# Web Push (VAPID). Leave empty to generate a key pair once and store it in the
# database; set both values to pin your own pair across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@feedwire.local
# When set, GET /api/metrics requires `Authorization: Bearer <token>`.
METRICS_TOKEN=
# Docker image for the database. pgvector/pgvector:pg17 enables HNSW semantic
# search; postgres:17 also works (search falls back to a real[] scan).
POSTGRES_IMAGE=pgvector/pgvector:pg17
